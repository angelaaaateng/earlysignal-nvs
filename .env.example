# Copy to .env.local. Leave both empty to run on demo data (the default).
# Both values are public: row-level security in the database is what protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: where structured logs are sent (see src/observability). Add its origin to connect-src in scripts/headers.mjs.
EXPO_PUBLIC_LOG_ENDPOINT=

# Set to 1 to force the demo backend even when Supabase is configured.
EXPO_PUBLIC_FORCE_MOCK=
