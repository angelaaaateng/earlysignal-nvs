  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve.mjs dist 8080",
    "test:e2e": "playwright test",
    "walkthrough": "node scripts/walkthrough.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db",
    "deploy:pages": "node scripts/deploy-gh-pages.mjs",
    "test:db": "jest --config jest.db.config.js",
    "db:local": "bash scripts/db-local.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
